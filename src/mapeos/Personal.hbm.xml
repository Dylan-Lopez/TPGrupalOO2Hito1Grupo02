<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

	<class name="datos.Personal" table="personal">

		<id name="idPersonal" column="idPersonal">
			<generator class="identity" />
		</id>

		<property name="nombre"
			column="nombre"
			type="string"
			not-null="true" />

		<property name="apellido"
			column="apellido"
			type="string"
			not-null="true" />

		<property name="dni"
			column="dni"
			type="long"
			unique="true"
			not-null="true" />

		<property name="fechaNacimiento"
			column="fechaNacimiento"
			type="java.time.LocalDate"
			not-null="true" />

		<property name="fechaIngreso"
			column="fechaIngreso"
			type="java.time.LocalDate"
			not-null="true" />

		<property name="sueldoBase"
			column="sueldoBase"
			type="double"
			not-null="true" />

		<!-- Herencia: Cocinero -->
		<joined-subclass name="datos.Cocinero" table="cocinero">
			<key column="idCocinero" />
			<property name="especialidad"
				column="especialidad"
				type="string"
				not-null="true" />
			<property name="categoria"
				column="categoria"
				type="float"
				not-null="true" />
		</joined-subclass>

		<!-- Herencia: Cajero -->
		<joined-subclass name="datos.Cajero" table="cajero">
			<key column="idCajero" />
			<property name="turno"
				column="turno"
				type="string"
				not-null="true" />
		</joined-subclass>
		
		<!--
		<generator class="foreign">
			<param name="property">unidad_venta</param>
		</generator>
		-->
		
		<!-- <many-to-one name="unidad_venta" class="datos.UnidadVenta" column="id_unidad_venta" not-null="true"/> -->

	</class>

</hibernate-mapping>
