<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Cliente" table="cliente">
    	<!-- ID -->
        <id name="idCliente" column="idCliente">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
        <property name="apellido" column="apellido" type="string" not-null="true"/>
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="dni" column="dni" type="integer" unique="true" not-null="true"/>
        <property name="fechaDeNacimiento" column="fechaDeNacimiento" type="java.time.LocalDate" not-null="true"/>
        <property name="baja" column="baja" type="boolean" not-null="true"/>
    </class>
</hibernate-mapping>
